<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Cold-start / splash background only — Compose paints everything after the first frame.

        Pinned rather than left to DayNight because the system resolves it before any app code
        runs, so it cannot read the stored theme mode. It matches the dark page of the DataStore
        default (THEME_MODE_DARK): the CRT phosphor background #0A0F0B.
        Letting it follow the system instead gave dark-theme users a
        white flash on light-mode devices.
    -->
    <color name="simpmusic_cold_start_background">#FF0A0F0B</color>

    <style name="Theme.SimpMusic" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/simpmusic_cold_start_background</item>
    </style>
</resources>
